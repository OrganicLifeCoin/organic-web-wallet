{
    "name": "olc-wallet",
    "version": "2.1.2",
    "description": "Non-custodial browser wallet for OrganicLifeCoin",
    "main": "scripts/index.js",
    "type": "module",
    "scripts": {
        "postinstall": "node postinstall.cjs",
        "build": "(node --localstorage-file=.localstorage.json ./node_modules/.bin/webpack --config webpack.prod.js) || (webpack build)",
        "buildDev": "(node --localstorage-file=.localstorage.json ./node_modules/.bin/webpack --config webpack.dev.js) || (webpack --config webpack.dev.js)",
        "watch": "(node --localstorage-file=.localstorage.json ./node_modules/.bin/webpack --watch) || (webpack --watch)",
        "dev": "(node --localstorage-file=.localstorage.json ./node_modules/.bin/webpack serve --config webpack.dev.js) || (webpack serve --config webpack.dev.js)",
        "prettier": "prettier --write --cache .",
        "test": "vitest",
        "test:olc": "vitest --run tests/unit/aes-gcm.spec.js tests/unit/vault_persistence.spec.js tests/components/stake/Stake.spec.js tests/unit/deterministic_masternode.spec.js tests/unit/deterministic_masternode_records.spec.js tests/components/DeterministicMasternodeFlow.spec.js tests/unit/startup_fetch.spec.js tests/unit/wallet_sync.spec.js tests/unit/wallet_balance_snapshot.spec.js tests/components/dashboard/WalletBalance.spec.js tests/components/dashboard/MultiWallet.spec.js",
        "coverage": "vitest --coverage"
    },
    "keywords": [
        "crypto",
        "OrganicLifeCoin",
        "OLC",
        "wallet"
    ],
    "author": "OrganicLifeCoin Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OrganicLifeCoin/organic-web-wallet.git"
    },
    "bugs": {
        "url": "https://github.com/OrganicLifeCoin/organic-web-wallet/issues"
    },
    "homepage": "https://github.com/OrganicLifeCoin/organic-web-wallet#readme",
    "devDependencies": {
        "@fluent/langneg": "^0.7.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vitest/coverage-istanbul": "^3.1.2",
        "@vue/preload-webpack-plugin": "^2.0.0",
        "@vue/test-utils": "^2.4.2",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.7.3",
        "css-minimizer-webpack-plugin": "^4.2.2",
        "fake-indexeddb": "^5.0.1",
        "file-loader": "^6.2.0",
        "happy-dom": "^15.11.7",
        "html-loader": "^4.2.0",
        "html-webpack-plugin": "^5.5.0",
        "mini-css-extract-plugin": "^2.7.2",
        "node-polyfill-webpack-plugin": "^2.0.1",
        "prettier": "^2.8.1",
        "raw-loader": "^4.0.2",
        "resource-loader": "^4.0.0-rc4",
        "toml": "^3.0.0",
        "vitest": "^3.1.2",
        "vue-loader": "^17.2.2",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1",
        "webpack-dev-server": "^5.2.2",
        "webpack-merge": "^5.8.0"
    },
    "dependencies": {
        "@fontsource/chivo": "^4.5.11",
        "@fontsource/montserrat": "^4.5.14",
        "@fortawesome/fontawesome-free": "^6.2.1",
        "@ledgerhq/hw-app-btc": "^6.7.0",
        "@ledgerhq/hw-transport-webusb": "^6.27.9",
        "@noble/hashes": "^1.1.5",
        "@noble/secp256k1": "^1.7.0",
        "@popperjs/core": "^2.11.6",
        "@vueuse/core": "^11.1.0",
        "base32": "^0.0.7",
        "bech32": "^2.0.0",
        "biginteger": "^1.0.3",
        "bip39": "^3.0.4",
        "bootstrap-4": "^4.0.0",
        "bs58": "^5.0.0",
        "buffer": "^6.0.3",
        "chart.js": "^4.2.1",
        "country-locale-map": "^1.8.15",
        "create-xpub": "^2.1.0",
        "hdkey": "^2.0.1",
        "idb": "^7.1.1",
        "ip-address": "^8.1.0",
        "jquery": "^3.6.3",
        "pinia": "^2.1.7",
        "pivx-promos": "^0.2.0",
        "pivx-shield": "^1.2.3",
        "pivx-shield-rust": "^1.2.3",
        "pivx-shield-rust-multicore": "^1.2.3",
        "qr-scanner": "^1.4.2",
        "qrcode-generator": "^1.4.4",
        "uuid": "^10.0.0",
        "vue": "^3.3.4",
        "vue-router": "^4.2.4"
    },
    "alias": {
        "@ledgerhq/devices": "@ledgerhq/devices/lib-es"
    }
}
