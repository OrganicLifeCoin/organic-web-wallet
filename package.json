        "lodash": "4.18.1",
        "nanoid": "3.3.18",
        "postcss": "8.5.28",
        "qs": "6.16.0",
        "uuid": "$uuid"
    },
    "alias": {
        "@ledgerhq/devices": "@ledgerhq/devices/lib-es"
    }
