{
    "name": "olc-wallet",
    "version": "2.1.2",
    "description": "Non-custodial browser wallet for OrganicLifeCoin",
    "main": "scripts/index.js",
    "type": "module",
    "scripts": {
        "postinstall": "node postinstall.cjs",
        "build": "webpack --config webpack.prod.js",
        "buildDev": "webpack --config webpack.dev.js",
        "watch": "webpack --config webpack.dev.js --watch",
        "dev": "webpack serve --config webpack.dev.js",
        "prettier": "prettier --write --cache .",
        "test": "vitest",
        "test:security": "vitest --run tests/unit/pq*.spec.js tests/unit/aes-gcm.spec.js",
        "coverage": "vitest --coverage"
    },
    "keywords": [
        "crypto",
        "OrganicLifeCoin",
        "OLC",
        "wallet"
    ],
    "author": "OrganicLifeCoin Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OrganicLifeCoin/organic-web-wallet.git"
    },
    "bugs": {
        "url": "https://github.com/OrganicLifeCoin/organic-web-wallet/issues"
    },
    "homepage": "https://github.com/OrganicLifeCoin/organic-web-wallet#readme",
    "devDependencies": {
        "@fluent/langneg": "^0.7.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vitest/coverage-istanbul": "^5.0.0",
        "@vue/preload-webpack-plugin": "^2.0.0",
        "@vue/test-utils": "^2.4.2",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^6.7.3",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "fake-indexeddb": "^5.0.1",
        "file-loader": "^6.2.0",
        "happy-dom": "^20.14.5",
        "html-loader": "^4.2.0",
        "html-webpack-plugin": "^5.5.0",
        "mini-css-extract-plugin": "^2.7.2",
        "prettier": "^2.8.1",
        "process": "^0.11.10",
        "raw-loader": "^4.0.2",
        "resource-loader": "^4.0.0-rc4",
        "stream-browserify": "^3.0.0",
        "toml": "^5.0.0",
        "vitest": "^5.0.0",
        "vue-loader": "^17.2.2",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1",
        "webpack-dev-server": "^5.2.2",
        "webpack-merge": "^5.8.0"
    },
