        "@scure/bip32": "^2.4.0",
        "@vueuse/core": "^11.1.0",
        "base32": "^0.0.7",
        "bech32": "^2.0.0",
        "biginteger": "^1.0.3",
        "bip39": "^3.0.4",
        "bootstrap-4": "^4.0.0",
        "bs58": "^5.0.0",
        "buffer": "^6.0.3",
        "chart.js": "^4.2.1",
